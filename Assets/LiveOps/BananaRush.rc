{
  "$schema": "https://ugs-config-schemas.unity3d.com/v1/remote-config.schema.json",
  "entries": {
    "config_revision": 1,
    "min_version": "1.0",
    "motd": "¡Bienvenidos a la Copa Banana de la Jungla!",
    "chat_enabled": true,
    "solo_practice_enabled": true,
    "leaderboard_enabled": true,
    "disabled_minigames": "none",
    "cup_points_multiplier": 1,
    "countdown_seconds": 5.0,
    "banana_target_score": 100,
    "banana_points_normal": 5,
    "banana_points_green": 20,
    "banana_points_explosive": -10,
    "banana_green_chance": 0.035,
    "banana_spawn_interval_scale": 1.0,
    "banana_time_limit_seconds": 150.0,
    "parkour_avalanche_speed": 2.55,
    "log_match_seconds": 95.0,
    "chest_target": 50,
    "memotest_peek_seconds": 7.0,
    "treechop_target": 30
  },
  "types": {
    "config_revision": "INT",
    "min_version": "STRING",
    "motd": "STRING",
    "chat_enabled": "BOOL",
    "solo_practice_enabled": "BOOL",
    "leaderboard_enabled": "BOOL",
    "disabled_minigames": "STRING",
    "cup_points_multiplier": "INT",
    "countdown_seconds": "FLOAT",
    "banana_target_score": "INT",
    "banana_points_normal": "INT",
    "banana_points_green": "INT",
    "banana_points_explosive": "INT",
    "banana_green_chance": "FLOAT",
    "banana_spawn_interval_scale": "FLOAT",
    "banana_time_limit_seconds": "FLOAT",
    "parkour_avalanche_speed": "FLOAT",
    "log_match_seconds": "FLOAT",
    "chest_target": "INT",
    "memotest_peek_seconds": "FLOAT",
    "treechop_target": "INT"
  }
}
